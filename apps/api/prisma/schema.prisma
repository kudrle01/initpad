generator client {
  provider      = "prisma-client-js"
  // "native" covers local development; the musl targets cover the Alpine
  // container image on both Apple Silicon (arm64) and x86 servers.
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                        @id @default(uuid())
  // Null for accounts that have no embedded-Gitea identity (GitHub-only SaaS
  // sign-in). Managed self-hosted accounts still carry their Gitea id.
  giteaId                    Int?                          @unique
  username                   String                        @unique
  name                       String?
  email                      String?                       @unique
  avatarUrl                  String?
  accessToken                String
  // Password hash (scrypt) for managed registration; null = OAuth-only (SSO) account.
  passwordHash               String?
  // Platform-wide authority is deliberately small. Workspace roles carry
  // project and team permissions; this role is for instance administration.
  platformRole               String                        @default("user") // admin | user
  // Account lifecycle (ADR-040). Deactivated accounts cannot sign in and their
  // live sessions are rejected. `mustChangePassword` forces a password change
  // (admin-provisioned temporary credentials, post-reset) before any other API
  // call is allowed. `tokenVersion` is embedded in the session JWT; bumping it
  // invalidates every previously issued session (reset, deactivate, change).
  active                     Boolean                       @default(true)
  mustChangePassword         Boolean                       @default(false)
  tokenVersion               Int                           @default(0)
  emailVerifiedAt            DateTime?
  createdAt                  DateTime                      @default(now())
  projects                   Project[]
  targets                    Target[]
  memberships                WorkspaceMember[]
  authTokens                 AuthToken[]
  externalIdentities         ExternalIdentity[]
  githubInstallationAccesses GitHubInstallationAccess[]    @relation("GitHubInstallationAuthorizedBy")
  githubInstallationSetups   GitHubInstallationSetup[]
  auditEvents                AuditEvent[]                  @relation("AuditEventActor")
  productionRequestsMade     ProductionDeploymentRequest[] @relation("ProductionRequestRequester")
  productionRequestsReviewed ProductionDeploymentRequest[] @relation("ProductionRequestReviewer")
}

// A GitHub App installation on a user or organization account (ADR-030). It is
// the trust binding that lets automation reach selected repositories through
// short-lived installation tokens; its lifecycle arrives via webhooks. The
// numeric installation id and immutable account id are stored as text to avoid
// 32-bit overflow. Mutable accountLogin is display data only. Uninstalls are
// retained as deletedAt audit records; authorization is explicit per workspace.
model GitHubInstallation {
  id                  String                     @id @default(uuid())
  installationId      String                     @unique
  accountId           String?
  accountLogin        String
  accountType         String // User | Organization
  repositorySelection String                     @default("selected") // all | selected
  suspendedAt         DateTime?
  deletedAt           DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  projects            Project[]
  accesses            GitHubInstallationAccess[]

  @@index([accountId])
  @@index([accountLogin])
}

// A GitHub installation is never globally available merely because a webhook
// mentioned it. This explicit grant is created only after a one-time setup
// callback initiated by an owner/admin of the target workspace (ADR-044).
model GitHubInstallationAccess {
  id                   String             @id @default(uuid())
  githubInstallation   GitHubInstallation @relation(fields: [githubInstallationId], references: [id], onDelete: Cascade)
  githubInstallationId String
  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId          String
  authorizedBy         User               @relation("GitHubInstallationAuthorizedBy", fields: [authorizedById], references: [id], onDelete: Restrict)
  authorizedById       String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([githubInstallationId, workspaceId])
  @@index([workspaceId])
  @@index([authorizedById])
}

// Opaque, hashed, short-lived and single-use state for the GitHub App setup
// redirect. It binds the callback to both the signed-in user and the selected
// workspace, preventing login CSRF and cross-workspace installation capture.
model GitHubInstallationSetup {
  id          String    @id @default(uuid())
  tokenHash   String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, workspaceId])
  @@index([expiresAt])
}

// A linked external SCM identity (GitHub today, GitLab later) — ADR-030/039.
// The account is bound by the provider's IMMUTABLE user id, never by e-mail, so
// a matching address can never silently merge accounts. A provider account
// links to at most one InitPad user, and an InitPad user links at most one
// account per provider.
model ExternalIdentity {
  id                     String    @id @default(uuid())
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                 String
  provider               String // github | gitlab
  providerUserId         String // immutable id from the provider
  username               String? // provider login at link time (display only, mutable)
  // User credentials are distinct from the identity itself. They authorize
  // provider operations on behalf of the user (personal GitHub repo creation),
  // are encrypted independently at rest and never appear in identity DTOs.
  accessTokenEncrypted   String?
  accessTokenExpiresAt   DateTime?
  refreshTokenEncrypted  String?
  refreshTokenExpiresAt  DateTime?
  credentialVersion      Int       @default(0)
  // Short database lease for rotation. GitHub refresh tokens are single-use;
  // this prevents two API instances from refreshing the same value at once.
  credentialRefreshingAt DateTime?
  createdAt              DateTime  @default(now())

  @@unique([provider, providerUserId])
  @@unique([provider, userId])
  @@index([userId])
}

// Single-use, hashed, expiring tokens for e-mail verification and password
// reset (ADR-040). Only the SHA-256 hash is stored; the plaintext lives solely
// in the link sent to the user. `usedAt` makes each token strictly one-shot.
model AuthToken {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  kind      String // email_verify | password_reset
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, kind])
}

model Workspace {
  id                         String                        @id @default(uuid())
  slug                       String                        @unique
  name                       String
  type                       String // personal | team
  createdAt                  DateTime                      @default(now())
  members                    WorkspaceMember[]
  projects                   Project[]
  targets                    Target[]
  targetAllocations          TargetAllocation[]
  githubInstallationAccesses GitHubInstallationAccess[]
  githubInstallationSetups   GitHubInstallationSetup[]
  auditEvents                AuditEvent[]
  // Every production publication requires a review. Personal workspaces allow
  // the requester to review their own request; team workspaces default to a
  // distinct reviewer (ADR-082).
  productionApprovalPolicy   String                        @default("separate-reviewer") // self-review | separate-reviewer
  productionRequests         ProductionDeploymentRequest[]
}

model WorkspaceMember {
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  role        String // owner | admin | maintainer | member | viewer
  createdAt   DateTime  @default(now())

  @@id([workspaceId, userId])
  @@index([userId])
}

// Immutable workspace activity used for security review and organizational
// reporting (ADR-077). Mutable names are copied as snapshots, while actorUserId
// may become null if an account is removed. Details are deliberately small and
// non-secret; application logs, credentials and configuration values belong in
// their dedicated bounded stores, never in this timeline.
model AuditEvent {
  id               String    @id @default(uuid())
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId      String
  actor            User?     @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorUserId      String?
  actorUsername    String
  actorDisplayName String?
  action           String
  outcome          String    @default("succeeded") // accepted | succeeded | failed | cancelled
  resourceType     String
  resourceId       String?
  resourceName     String?
  operationType    String? // deployment | provisioning
  operationId      String?
  details          Json?
  createdAt        DateTime  @default(now())

  @@unique([operationType, operationId, action])
  @@index([workspaceId, createdAt, id])
  @@index([workspaceId, action, createdAt])
  @@index([workspaceId, resourceType, resourceId, createdAt])
  @@index([operationType, operationId])
}

// A first-class deployment target: a place an environment can deploy to.
// "Everything is a target" — the built-in simulated infrastructure (Docker,
// the SSH VPS, the SFTP static host) is seeded as `builtin` targets, and users
// register their own servers (e.g. a school SFTP host, a VPS) as `user`
// targets. An Environment references one Target.
//
// Built-in targets carry only display metadata; their live connection details
// come from config (single source of truth for the simulated infra), so the
// deploy path for them is unchanged. User targets carry an encrypted secret
// (password / PEM key) and are used to build the real connection.
model Target {
  id                       String             @id @default(uuid())
  name                     String
  kind                     String // 'docker' | 'ssh' | 'sftp'
  scope                    String // 'builtin' | 'user'
  // What runtimes this target can execute (comma-separated): a subset of
  // 'static','node','php','python'. An environment can bind to a target only
  // when its template's runtime is in this set (e.g. our static nginx host
  // cannot run PHP, but a real PHP-capable SFTP host can).
  capabilities             String
  host                     String?
  port                     Int?
  username                 String?
  auth                     String? // 'password' | 'key'
  secret                   String? // encrypted password or PEM private key (user targets)
  hostKeyFingerprint       String? // trusted OpenSSH SHA256 host-key fingerprint
  remotePath               String? // writable root on the remote
  publicUrl                String? // public address the deployed app/site is reachable at
  // Lifecycle of the control-plane relationship. Disconnecting or retiring a
  // target never tears down workloads; it only revokes management access.
  managementState          String             @default("active") // active | disconnected | retired
  managementStateChangedAt DateTime?
  // Docker application exposure: random published ports for local/lab, or a
  // stable HTTPS hostname reconciled through a trusted gateway (ADR-073).
  routingMode              String             @default("direct-port") // direct-port | managed-gateway
  gatewayAdapter           String? // caddy; null outside managed-gateway
  gatewayPreflightStatus   String             @default("not-run") // not-run | queued | running | passed | failed
  gatewayPreflightJobId    String?
  gatewayPreflightAt       DateTime?
  gatewayPreflightError    String?
  // Last successful connection test; null = never verified.
  verifiedAt               DateTime?
  // Owner of a user target; null for built-in (shared) targets.
  owner                    User?              @relation(fields: [ownerId], references: [id])
  ownerId                  String?
  // Null only for built-in shared targets. User targets belong to a workspace;
  // ownerId remains the credential/SCM identity during the tenancy migration.
  workspace                Workspace?         @relation(fields: [workspaceId], references: [id])
  workspaceId              String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  environments             Environment[]
  allocations              TargetAllocation[]
  agent                    Agent?
  agentJobs                AgentJob[]
  gatewayRoutes            GatewayRoute[]

  // A workspace cannot have two user targets with the same name. Built-ins
  // have null workspaceId and stable ids (Postgres permits multiple NULLs).
  @@unique([workspaceId, name])
  @@index([workspaceId, managementState])
  @@index([gatewayPreflightStatus])
}

// Outbound-only identity of one InitPad Agent installed on one physical Docker
// target (ADR-066). Raw enrollment and agent credentials are returned exactly
// once and never persisted; only SHA-256 hashes cross the database boundary.
// Workspace authorization remains derived from Target -> TargetAllocation so
// the agent cannot become a second tenancy model.
model Agent {
  id                   String     @id @default(uuid())
  target               Target     @relation(fields: [targetId], references: [id], onDelete: Cascade)
  targetId             String     @unique
  enrollmentTokenHash  String?    @unique
  enrollmentExpiresAt  DateTime?
  credentialHash       String?    @unique
  credentialGeneration Int        @default(0)
  credentialActivatedAt DateTime?
  // Rotation is a two-phase overlap. The current hash remains valid until the
  // Agent proves it atomically stored and can authenticate with the pending
  // generation; plaintext credentials never enter the database.
  pendingCredentialHash       String?   @unique
  pendingCredentialGeneration Int?
  pendingCredentialIssuedAt   DateTime?
  protocolVersion      Int        @default(1)
  version              String?
  capabilities         Json?
  enrolledAt           DateTime?
  lastSeenAt           DateTime?
  disabledAt           DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  leasedJobs           AgentJob[] @relation("AgentJobLeaseOwner")

  @@index([lastSeenAt])
  @@index([disabledAt])
}

// Workspace-scoped *usage* of a physical Target (ADR-060). Separates "what the
// infrastructure is" (Target, which holds all credentials) from "how a given
// workspace may use it": an isolating namespace/rootPath, the public URL, the
// subset of capabilities allowed, status, and basic quotas. A shared built-in
// target therefore gets one allocation per workspace, so two workspaces never
// collide on container names or SFTP release paths. Credentials are NEVER
// duplicated here.
model TargetAllocation {
  id              String         @id @default(uuid())
  target          Target         @relation(fields: [targetId], references: [id], onDelete: Cascade)
  targetId        String
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId     String
  // Isolating prefix for this workspace on the (possibly shared) target:
  // a container-name prefix for docker/ssh, the releases root for sftp.
  namespace       String
  rootPath        String?
  // Public address apps deployed through this allocation are reached at.
  publicUrl       String?
  // Subset of the target's capabilities this workspace may use.
  capabilities    String
  status          String         @default("active") // active | disabled
  // Basic quota: how many environments may bind to this allocation.
  maxEnvironments Int            @default(50)
  // Per-workload Docker limits. They are copied into each deployment intent so
  // both the built-in runtime and a remote Agent enforce the same workspace
  // policy instead of relying on host-wide defaults.
  cpuLimitMillicores Int          @default(1000)
  memoryLimitMb       Int          @default(512)
  pidsLimit           Int          @default(256)
  // Optional lifetime for non-production workloads. Null keeps the environment
  // until a user removes it; production is never eligible for TTL cleanup.
  devTtlHours         Int?
  testTtlHours        Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  environments    Environment[]
  agentJobs       AgentJob[]
  gatewayRoutes   GatewayRoute[]

  @@unique([workspaceId, targetId])
  @@index([targetId])
}

model Project {
  id                 String                        @id @default(uuid())
  name               String
  templateId         String
  repoPath           String
  repoUrl            String?
  // Stable SCM identity (ADR-043). Display name and URL may change; provider +
  // repositoryId is the immutable identity once the provider has resolved it.
  // repositoryId is nullable only for legacy rows while startup reconciliation
  // resolves the real Gitea id. The explicit coordinates remove every implicit
  // owner/name parse from repoUrl and prepare organization-owned GitHub repos.
  scmProvider        String                        @default("gitea") // gitea | github
  scmRepositoryId    String?
  scmOwner           String
  scmRepositoryName  String
  scmFullName        String
  scmDefaultBranch   String                        @default("main")
  scmInstallation    GitHubInstallation?           @relation(fields: [scmInstallationId], references: [id], onDelete: SetNull)
  scmInstallationId  String?
  lastCommit         String
  // SHA-256 hash of the repository-specific CI webhook token. The plaintext
  // exists only as a Gitea Actions secret and is never persisted by InitPad.
  ciDeployTokenHash  String?
  createdAt          DateTime                      @default(now())
  owner              User?                         @relation(fields: [ownerId], references: [id])
  ownerId            String?
  // Authorization and visibility are workspace-scoped. ownerId remains the
  // repository/SCM identity so existing repo URLs and image names do not move.
  workspace          Workspace                     @relation(fields: [workspaceId], references: [id])
  workspaceId        String
  environments       Environment[]
  buildArtifacts     BuildArtifact[]
  productionRequests ProductionDeploymentRequest[]

  @@unique([workspaceId, name])
  @@unique([scmProvider, scmRepositoryId])
  @@index([scmProvider, scmFullName])
  @@index([scmInstallationId])
}

// Immutable CI outputs accepted at the repository/commit trust boundary.
// GitHub artifacts are verified through the workspace-bound App installation,
// then ingested into platform-owned storage (the prototype's Docker daemon).
model BuildArtifact {
  id                 String                        @id @default(uuid())
  project            Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId          String
  sourceProvider     String // github-actions (Gitea continues to use OCI)
  providerArtifactId String
  providerRunId      String
  commitSha          String
  name               String
  digest             String
  sizeBytes          BigInt
  expiresAt          DateTime
  status             String                        @default("accepted") // accepted | ingesting | available | failed
  storageKind        String?
  storageRef         String?
  error              String?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  environments       Environment[]
  operations         DeploymentOperation[]
  productionRequests ProductionDeploymentRequest[]

  @@unique([sourceProvider, providerArtifactId])
  @@index([projectId, commitSha, createdAt])
  @@index([status, createdAt])
}

model Environment {
  id                 String  @id @default(uuid())
  project            Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId          String
  name               String
  order              Int
  provider           String
  status             String
  version            String?
  url                String?
  // Reason of the last failure (health check / missing image / …), otherwise null.
  statusReason       String?
  // True while a requested deployment (including a target move) has not yet
  // published successfully. Distinguishes the UI action Deploy from an idle,
  // explicitly cancelled first run (Run again).
  deploymentRequired Boolean @default(false)
  // Application port allocated on the shared SSH target (fake-vps). Assigned
  // from a configured range on the first SSH deploy, released on teardown.
  // The unique constraint makes port collisions impossible by construction
  // (Postgres allows multiple NULLs in a unique column).
  allocatedPort      Int?    @unique

  // The deployment target this environment runs on. dev/test point at a
  // built-in target (the simulated infra); prod points at a built-in or a
  // user-registered target. `provider` mirrors target.kind (denormalised for
  // the many read paths that switch on the provider kind).
  target            Target?               @relation(fields: [targetId], references: [id])
  targetId          String?
  // Workspace-scoped usage of the target (ADR-060). Nullable during the
  // additive migration/backfill; deploy resolves the target through this.
  allocation        TargetAllocation?     @relation(fields: [allocationId], references: [id], onDelete: SetNull)
  allocationId      String?
  // Generation/lock for the currently running operation. A stale asynchronous
  // deploy may only publish its result when this id still matches.
  activeOperationId String?
  operations        DeploymentOperation[]
  // Exact build output currently running. Commit SHA alone is insufficient:
  // two workflow runs of the same commit may produce different digests.
  buildArtifact     BuildArtifact?        @relation(fields: [buildArtifactId], references: [id], onDelete: SetNull)
  buildArtifactId   String?
  // Incremented atomically with every config mutation. Approval and deployment
  // locks compare this scalar instead of reading or hashing secret values.
  configRevision    Int                   @default(0)
  // Set only for dev/test after a successful deployment when their allocation
  // defines a TTL. The warning timestamp supports a deterministic UI warning;
  // no background task ever expires production.
  expiresAt          DateTime?
  expiryWarningAt    DateTime?

  configVars         AppConfigVar[]
  gatewayRoute       GatewayRoute?
  diagnostic         WorkloadDiagnostic?
  productionRequests ProductionDeploymentRequest[]

  @@unique([projectId, name])
  @@index([buildArtifactId])
  @@index([allocationId])
  @@index([expiresAt])
}

// Stable, control-plane-owned route reservation for managed-gateway targets
// (ADR-073). The hostname is allocated once from the immutable Environment id;
// project rename, redeploy and stop/start therefore preserve the public URL.
// Desired and observed state remain separate so Agent reconciliation can be
// idempotent and a failed gateway update cannot be mistaken for publication.
model GatewayRoute {
  id                 String           @id @default(uuid())
  environment        Environment      @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  environmentId      String           @unique
  target             Target           @relation(fields: [targetId], references: [id], onDelete: Restrict)
  targetId           String
  allocation         TargetAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  allocationId       String
  hostname           String           @unique
  publicUrl          String           @unique
  desiredState       String           @default("reserved") // reserved | active | stopped | absent
  desiredRevision    String?
  observedState      String           @default("absent") // absent | active | stopped | failed
  observedRevision   String?
  generation         Int              @default(0)
  observedGeneration Int              @default(0)
  reconcileJobId     String?
  lastError          String?
  reconciledAt       DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  agentJobs          AgentJob[]

  @@index([targetId, desiredState])
  @@index([allocationId])
}

// Runtime configuration and secrets for a deployed application (ADR-061),
// scoped to a single Environment. Non-secret values are stored in clear for
// editing; secret values are encrypted at rest (INITPAD_ENCRYPTION_KEY) and are
// never returned in plaintext by the API. Applied to the app at deploy time
// (Docker Env / SSH runtime), never baked into the build-once image.
model AppConfigVar {
  id            String      @id @default(uuid())
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  environmentId String
  key           String
  // Plaintext for isSecret=false; ciphertext (encryptSecret) for isSecret=true.
  value         String
  isSecret      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([environmentId, key])
  @@index([environmentId])
}

// Persistent audit of provisioning a project (create or import) — ADR-025/Phase
// 3. It records the step reached (validate → repository → ci → done) and the
// outcome, so a failed setup is observable and no external state is claimed to
// exist before its step succeeded. Kept as a plain audit row (no FK) so it
// survives project deletion.
model ProvisioningOperation {
  id             String               @id @default(uuid())
  workspaceId    String
  projectId      String?
  projectName    String
  kind           String // create | import
  status         String               @default("running") // running | succeeded | failed | interrupted | retrying | retried | cleaning
  step           String               @default("validate") // validate | repository | ci | done
  message        String?
  requestedById  String?
  request        Json? // validated create/import DTO; never credentials
  retryOfId      String?
  attempt        Int                  @default(1)
  leaseOwner     String?
  leaseExpiresAt DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  finishedAt     DateTime?
  effects        ProvisioningEffect[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status, createdAt])
  @@index([projectId])
  @@index([retryOfId])
}

// Durable intent/effect journal for non-transactional provisioning. An entry
// is written before InitPad mutates an SCM, then advanced through applying and
// applied (or compensated). This makes partial external state observable and
// gives rollback an explicit checklist instead of relying on catch blocks and
// memory. Metadata must never contain credentials or secret values.
model ProvisioningEffect {
  id            String                @id @default(uuid())
  operation     ProvisioningOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  operationId   String
  key           String
  kind          String // repository | collaborator | secrets | project
  status        String                @default("planned") // planned | applying | applied | failed | compensated | compensation_failed
  metadata      Json?
  error         String?
  createdAt     DateTime              @default(now())
  appliedAt     DateTime?
  compensatedAt DateTime?

  @@unique([operationId, key])
  @@index([operationId, createdAt])
}

model DeploymentOperation {
  id                String                       @id @default(uuid())
  environment       Environment                  @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  environmentId     String
  buildArtifact     BuildArtifact?               @relation(fields: [buildArtifactId], references: [id], onDelete: SetNull)
  buildArtifactId   String?
  kind              String // deploy | promote | redeploy | start
  status            String // running | succeeded | failed | cancelled
  // Provider-neutral, durable delivery state. `status` remains the coarse
  // active/terminal lock while phase explains where an active operation is.
  phase             String                       @default("queued") // queued | assigned | running | verifying | succeeded | failed | unhealthy | cancelled
  version           String?
  message           String?
  // Immutable deployment destination snapshot. Environment.target may change
  // later; historical activity must keep the target that actually received it.
  targetIdSnapshot  String?
  targetName        String
  providerSnapshot  String
  createdAt         DateTime                     @default(now())
  startedAt         DateTime                     @default(now())
  finishedAt        DateTime?
  agentJobs         AgentJob[]
  productionRequest ProductionDeploymentRequest?

  @@index([environmentId, createdAt])
  @@index([status])
  @@index([buildArtifactId])
}

// Immutable intent to publish one exact verified build to production. The
// request contains identity/revision snapshots, never config or credential
// values. Its deployment operation is attached only after an authorized review.
model ProductionDeploymentRequest {
  id                         String               @id @default(uuid())
  workspace                  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId                String
  project                    Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId                  String
  projectNameSnapshot        String
  environment                Environment          @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  environmentId              String
  requestedBy                User?                @relation("ProductionRequestRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  requestedById              String?
  requestedByUsername        String
  requestedByDisplayName     String?
  reviewedBy                 User?                @relation("ProductionRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById               String?
  reviewedByUsername         String?
  reviewedByDisplayName      String?
  kind                       String // promote | redeploy | rollback
  status                     String               @default("pending") // pending | approving | approved | rejected | stale | failed | cancelled
  sourceEnvironment          String
  candidateOperationId       String?
  candidateStateToken        String?
  version                    String
  buildArtifact              BuildArtifact?       @relation(fields: [buildArtifactId], references: [id], onDelete: SetNull)
  buildArtifactId            String?
  artifactDigest             String?
  targetIdSnapshot           String?
  allocationIdSnapshot       String?
  targetNameSnapshot         String
  providerSnapshot           String
  configRevisionSnapshot     Int
  targetRevisionSnapshot     DateTime?
  allocationRevisionSnapshot DateTime?
  stateToken                 String
  policySnapshot             String
  reviewNote                 String?
  deploymentOperation        DeploymentOperation? @relation(fields: [deploymentOperationId], references: [id], onDelete: SetNull)
  deploymentOperationId      String?              @unique
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  reviewedAt                 DateTime?

  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
  @@index([environmentId, status, createdAt])
  @@index([requestedById, status])
}

// Durable, target-scoped delivery envelope polled by an outbound InitPad Agent
// (ADR-069). The long-lived Agent credential authenticates the physical target;
// every claim additionally receives a short-lived fencing token. A stale
// worker therefore cannot renew or publish after the lease is reassigned.
model AgentJob {
  id                    String               @id @default(uuid())
  target                Target               @relation(fields: [targetId], references: [id], onDelete: Cascade)
  targetId              String
  allocation            TargetAllocation?    @relation(fields: [allocationId], references: [id], onDelete: SetNull)
  allocationId          String?
  deploymentOperation   DeploymentOperation? @relation(fields: [deploymentOperationId], references: [id], onDelete: SetNull)
  deploymentOperationId String?
  // Durable order inside a multi-step deployment workflow. Managed gateway
  // operations use workload -> route for deploy/start and route -> workload
  // for stop/remove; direct-port operations remain a single step.
  operationStep         Int?
  gatewayRoute          GatewayRoute?        @relation(fields: [gatewayRouteId], references: [id], onDelete: SetNull)
  gatewayRouteId        String?
  diagnosticProjection  WorkloadDiagnostic?
  leasedByAgent         Agent?               @relation("AgentJobLeaseOwner", fields: [leasedByAgentId], references: [id], onDelete: SetNull)
  leasedByAgentId       String?

  dedupeKey       String @unique
  kind            String // probe | lifecycle-test | gateway-preflight | gateway-route | deploy | start | stop | remove | status | logs | rollback
  protocolVersion Int    @default(1)
  payload         Json
  status          String @default("queued") // blocked | queued | leased | succeeded | failed | cancelled
  attempt         Int    @default(0)

  // Only the SHA-256 hash crosses the DB boundary. The plaintext lease token is
  // returned once to the winning Agent claim and acts as its fencing token.
  leaseTokenHash String?   @unique
  leasedAt       DateTime?
  leaseExpiresAt DateTime?

  progressSequence Int     @default(0)
  progressPercent  Int     @default(0)
  progressStage    String  @default("queued")
  message          String?
  resultCode       String?
  // Bounded structured lifecycle outcome (state/revision/host port). It never
  // contains application logs, config or secrets.
  result           Json?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?

  @@unique([deploymentOperationId, operationStep])
  @@index([targetId, status, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([allocationId])
  @@index([deploymentOperationId, status])
  @@index([gatewayRouteId])
}

// Latest bounded workload observation for one environment (ADR-076). Logs do
// not live in AgentJob or deployment history and each refresh overwrites this
// projection, preventing an unbounded application-log archive in the control
// plane. currentJobId fences a late/stale Agent completion.
model WorkloadDiagnostic {
  id            String      @id @default(uuid())
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  environmentId String      @unique
  currentJob    AgentJob?   @relation(fields: [currentJobId], references: [id], onDelete: SetNull)
  currentJobId  String?     @unique
  requestedById String?
  status        String      @default("idle") // idle | queued | running | succeeded | failed
  runtimeState  String? // running | stopped | missing
  revision      String?
  exitCode      Int?
  health        String? // healthy | unhealthy | not-running | missing
  logs          String      @default("")
  message       String?
  requestedAt   DateTime?
  observedAt    DateTime?
  finishedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status, requestedAt])
}
