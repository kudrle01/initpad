generator client {
  provider = "prisma-client-js"
  // "native" covers local development; the musl targets cover the Alpine
  // container image on both Apple Silicon (arm64) and x86 servers.
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  giteaId      Int       @unique
  username     String    @unique
  name         String?
  email        String?   @unique
  avatarUrl    String?
  accessToken  String
  // Password hash (scrypt) for managed registration; null = OAuth-only (SSO) account.
  passwordHash String?
  createdAt    DateTime  @default(now())
  projects     Project[]
  targets      Target[]
}

// A first-class deployment target: a place an environment can deploy to.
// "Everything is a target" — the built-in simulated infrastructure (Docker,
// the SSH VPS, the SFTP static host) is seeded as `builtin` targets, and users
// register their own servers (e.g. a school SFTP host, a VPS) as `user`
// targets. An Environment references one Target.
//
// Built-in targets carry only display metadata; their live connection details
// come from config (single source of truth for the simulated infra), so the
// deploy path for them is unchanged. User targets carry an encrypted secret
// (password / PEM key) and are used to build the real connection.
model Target {
  id           String        @id @default(uuid())
  name         String
  kind         String        // 'docker' | 'ssh' | 'sftp'
  scope        String        // 'builtin' | 'user'
  // What runtimes this target can execute (comma-separated): a subset of
  // 'static','node','php','python'. An environment can bind to a target only
  // when its template's runtime is in this set (e.g. our static nginx host
  // cannot run PHP, but a real PHP-capable SFTP host can).
  capabilities String
  host         String?
  port         Int?
  username     String?
  auth         String?       // 'password' | 'key'
  secret       String?       // encrypted password or PEM private key (user targets)
  remotePath   String?       // writable root on the remote
  publicUrl    String?       // public address the deployed app/site is reachable at
  // Last successful connection test; null = never verified.
  verifiedAt   DateTime?
  // Owner of a user target; null for built-in (shared) targets.
  owner        User?         @relation(fields: [ownerId], references: [id])
  ownerId      String?
  createdAt    DateTime      @default(now())
  environments Environment[]

  // A user cannot have two targets with the same name.
  @@unique([ownerId, name])
}

model Project {
  id           String        @id @default(uuid())
  name         String
  templateId   String
  repoPath     String
  repoUrl      String?
  lastCommit   String
  // SHA-256 hash of the repository-specific CI webhook token. The plaintext
  // exists only as a Gitea Actions secret and is never persisted by InitPad.
  ciDeployTokenHash String?
  createdAt    DateTime      @default(now())
  owner        User?         @relation(fields: [ownerId], references: [id])
  ownerId      String?
  environments Environment[]

  // The name is unique per account — two users may own same-named projects.
  @@unique([ownerId, name])
}

model Environment {
  id        String   @id @default(uuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  name      String
  order     Int
  provider  String
  status    String
  version   String?
  url       String?
  // Reason of the last failure (health check / missing image / …), otherwise null.
  statusReason String?
  // Application port allocated on the shared SSH target (fake-vps). Assigned
  // from a configured range on the first SSH deploy, released on teardown.
  // The unique constraint makes port collisions impossible by construction
  // (Postgres allows multiple NULLs in a unique column).
  allocatedPort Int? @unique

  // The deployment target this environment runs on. dev/test point at a
  // built-in target (the simulated infra); prod points at a built-in or a
  // user-registered target. `provider` mirrors target.kind (denormalised for
  // the many read paths that switch on the provider kind).
  target   Target? @relation(fields: [targetId], references: [id])
  targetId String?
  // Generation/lock for the currently running operation. A stale asynchronous
  // deploy may only publish its result when this id still matches.
  activeOperationId String?
  operations DeploymentOperation[]

  @@unique([projectId, name])
}

model DeploymentOperation {
  id            String      @id @default(uuid())
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  environmentId String
  kind          String      // deploy | promote | redeploy | start
  status        String      // running | succeeded | failed | cancelled
  version       String?
  message       String?
  createdAt     DateTime    @default(now())
  startedAt     DateTime    @default(now())
  finishedAt    DateTime?

  @@index([environmentId, createdAt])
  @@index([status])
}
