generator client {
  provider = "prisma-client-js"
  // "native" covers local development; the musl targets cover the Alpine
  // container image on both Apple Silicon (arm64) and x86 servers.
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  giteaId      Int       @unique
  username     String    @unique
  name         String?
  email        String?   @unique
  avatarUrl    String?
  accessToken  String
  // Password hash (scrypt) for managed registration; null = OAuth-only (SSO) account.
  passwordHash String?
  createdAt    DateTime  @default(now())
  projects     Project[]
}

model Project {
  id           String        @id @default(uuid())
  name         String
  templateId   String
  repoPath     String
  repoUrl      String?
  lastCommit   String
  createdAt    DateTime      @default(now())
  owner        User?         @relation(fields: [ownerId], references: [id])
  ownerId      String?
  environments Environment[]

  // The name is unique per account — two users may own same-named projects.
  @@unique([ownerId, name])
}

model Environment {
  id        String   @id @default(uuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  name      String
  order     Int
  provider  String
  status    String
  version   String?
  url       String?
  // Reason of the last failure (health check / missing image / …), otherwise null.
  statusReason String?
  // Application port allocated on the shared SSH target (fake-vps). Assigned
  // from a configured range on the first SSH deploy, released on teardown.
  // The unique constraint makes port collisions impossible by construction
  // (Postgres allows multiple NULLs in a unique column).
  allocatedPort Int? @unique

  // User-provided deployment target (typically prod: your own server). When
  // null, the platform's built-in demo target is used. The secret (password or
  // private key) is encrypted at rest (AES-256-GCM, see common/secret.ts).
  targetKind      String? // 'sftp' | 'ssh'
  targetHost      String?
  targetPort      Int?
  targetUsername  String?
  targetAuth      String? // 'password' | 'key'
  targetSecret    String? // encrypted password or PEM private key
  targetPath      String? // writable root on the remote
  targetPublicUrl String?

  @@unique([projectId, name])
}
