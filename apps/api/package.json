{
  "name": "@initpad/api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend platformy – API, generování projektů, řízení nasazení",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "postinstall": "prisma generate"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": ["ts-jest", { "tsconfig": { "module": "commonjs", "moduleResolution": "node" } }]
    },
    "testEnvironment": "node"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@prisma/client": "^5.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.6",
    "dockerode": "^4.0.2",
    "handlebars": "^4.7.8",
    "prisma": "^5.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ssh2": "^1.15.0",
    "tar-fs": "^3.0.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/dockerode": "^3.3.31",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.5.0",
    "@types/ssh2": "^1.15.0",
    "@types/tar-fs": "^2.0.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.4"
  }
}
