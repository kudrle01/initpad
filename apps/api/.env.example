# PostgreSQL (viz infra/docker-compose.yml). Bez DB se API nespustí.
DATABASE_URL=postgresql://initpad:initpad@localhost:5432/initpad?schema=public

# Gitea (interní Git server) – viz infra/docker-compose.yml
INITPAD_GITEA_URL=http://localhost:3001
INITPAD_GITEA_USER=
# Token MUSÍ patřit Gitea ADMINOVI – platforma jím při řízené registraci
# zakládá uživatelské účty (POST /admin/users). Volitelně lze admin token
# oddělit přes INITPAD_GITEA_ADMIN_TOKEN (jinak se použije tenhle).
INITPAD_GITEA_TOKEN=
# INITPAD_GITEA_ADMIN_TOKEN=

# Autor commitů, které platforma vytváří
INITPAD_GIT_AUTHOR_NAME=DevPlatform
INITPAD_GIT_AUTHOR_EMAIL=platform@local

# Přihlášení přes Gitea (OAuth2). V Gitea: Settings → Applications →
# Create OAuth2 Application, Redirect URI = INITPAD_OAUTH_CALLBACK_URL.
INITPAD_OAUTH_CLIENT_ID=
INITPAD_OAUTH_CLIENT_SECRET=
INITPAD_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/callback
INITPAD_FRONTEND_URL=http://localhost:5173
INITPAD_JWT_SECRET=zmen-me-na-nahodny-retezec
