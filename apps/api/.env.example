DATABASE_URL=postgresql://initpad:initpad@localhost:5432/initpad?schema=public

# Gitea (interní Git server) – viz infra/docker-compose.yml
INITPAD_GITEA_URL=http://gitea.localhost:3001
INITPAD_GITEA_USER=
INITPAD_GITEA_TOKEN=
# INITPAD_GITEA_ADMIN_TOKEN=

INITPAD_GIT_AUTHOR_NAME=InitPad Bot
INITPAD_GIT_AUTHOR_EMAIL=bot@initpad.local

INITPAD_ENCRYPTION_KEY=zmen-me-na-nahodny-retezec

# Dedicated Gitea system-webhook secret. Per-project CI tokens are generated
# automatically and stored only as hashes in PostgreSQL.
INITPAD_SCM_WEBHOOK_TOKEN=zmen-me-na-nahodny-retezec
INITPAD_SCM_WEBHOOK_URL=http://host.docker.internal:3000
INITPAD_PLATFORM_INTERNAL_URL=http://platform.localhost:3000
INITPAD_REGISTRY_HOST=gitea.localhost:3001

INITPAD_FRONTEND_URL=http://localhost:5173
INITPAD_JWT_SECRET=zmen-me-na-nahodny-retezec
INITPAD_REGISTRATION_MODE=open
# Vite proxies /api once. Direct API exposure would use 0 instead.
INITPAD_TRUST_PROXY_HOPS=1

INITPAD_OIDC_ISSUER=http://host.docker.internal:3000/api
# Browser-facing authorization endpoint. Vite proxies /api to the API during
# development, keeping the OIDC round trip on the same origin as the web app.
INITPAD_OIDC_PUBLIC_URL=http://localhost:5173/api
INITPAD_OIDC_CLIENT_ID=gitea
INITPAD_OIDC_CLIENT_SECRET=zmen-me-na-nahodny-retezec

# SSH cíl (fake-vps) – runtime aplikace (Node)
INITPAD_SSH_HOST=localhost
INITPAD_SSH_PORT=2200
INITPAD_SSH_USER=deploy
INITPAD_SSH_PASSWORD=deploy
INITPAD_SSH_APP_PORT_BASE=8090
INITPAD_SSH_APP_PORT_SLOTS=10
# SFTP cíl (fake-sftp + nginx) – statické/PHP aplikace
INITPAD_SFTP_HOST=localhost
INITPAD_SFTP_PORT=2222
INITPAD_SFTP_USER=deploy
INITPAD_SFTP_PASSWORD=deploy
INITPAD_SFTP_PUBLIC_URL=http://localhost:8085
