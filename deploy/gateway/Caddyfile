# Edge of the InitPad managed gateway: terminates TLS for the application zone
# and hands plain HTTP to the inner gateway, which InitPad Agent configures.
# Certificates come from the private CA (step-ca) over ACME and renew by
# themselves. The only names ever certified are the zone apex and the names
# below it, so the edge cannot be used to obtain certificates for other hosts.
{
	admin off
	# Explicit issuer: for names such as *.local Caddy would otherwise pick
	# its own internal CA instead of the private CA the clients trust.
	cert_issuer acme {
		dir {$GATEWAY_CA_URL}
		trusted_roots /etc/caddy/ca-root.crt
	}
	on_demand_tls {
		ask http://127.0.0.1:5555/allowed
	}
}

# Answers the on-demand question "may a certificate be issued for this name?".
# Reachable only from the edge container itself.
http://127.0.0.1:5555 {
	bind 127.0.0.1
	@allowed expression {query.domain}.endsWith('.{$GATEWAY_DOMAIN}') && {query.domain}.size() <= 253
	respond @allowed 200
	respond 403
}

# The apex is certified at start-up (the Agent's gateway preflight checks it).
{$GATEWAY_DOMAIN} {
	header -Server
	reverse_proxy initpad-gateway:8080
}

# Application hostnames: certified on first use, only inside the zone.
https:// {
	tls {
		on_demand
	}
	header -Server
	reverse_proxy initpad-gateway:8080
}
