# Zone InitPad serves applications under. DNS needs an A record for the name
# itself and a wildcard A record (*.<name>) pointing at this server.
GATEWAY_DOMAIN=apps.example.lan

# Private CA. Leave the defaults to run step-ca next to the gateway.
GATEWAY_CA_NAME=InitPad Gateway CA
GATEWAY_CA_HOST=ca.example.lan
GATEWAY_CA_URL=https://ca:9000/acme/acme/directory
