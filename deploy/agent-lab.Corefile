.:53 {
	errors

	# Resolve the whole local application zone to the fixed TLS edge. The
	# template is authoritative only for this .test zone; all other names keep
	# using the host resolver through Docker's embedded DNS.
	template IN A {$INITPAD_AGENT_LAB_GATEWAY_DOMAIN} {
		answer "{{ .Name }} 60 IN A {$INITPAD_AGENT_LAB_EDGE_IP}"
	}
	template IN AAAA {$INITPAD_AGENT_LAB_GATEWAY_DOMAIN} {
		rcode NOERROR
	}

	forward . /etc/resolv.conf
	cache 30
	loop
}
