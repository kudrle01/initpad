# InitPad public control-plane contract. Copy only for a staging deployment.
# Secret entries below are paths to read-only files projected by the deployment
# secret manager. This file must never contain the secret values themselves.

INITPAD_PUBLIC_URL=https://initpad.example
INITPAD_PLATFORM_VERSION=0.2.10
INITPAD_UPDATE_REPOSITORY=kudrle01/initpad

# Use immutable references from one verified InitPad platform release.
INITPAD_API_IMAGE=ghcr.io/kudrle01/initpad-api@sha256:REPLACE_WITH_64_HEX_DIGEST
INITPAD_WEB_IMAGE=ghcr.io/kudrle01/initpad-web@sha256:REPLACE_WITH_64_HEX_DIGEST
INITPAD_AGENT_IMAGE=ghcr.io/kudrle01/initpad-agent@sha256:REPLACE_WITH_64_HEX_DIGEST
INITPAD_AGENT_RELEASE_VERSION=0.14.3

# External PostgreSQL. TLS and certificate requirements belong in this URL.
INITPAD_DATABASE_URL_FILE=/secure/runtime/secrets/database_url

# External private S3-compatible store. Leave endpoint empty only for AWS S3.
INITPAD_ARTIFACT_S3_ENDPOINT=https://s3.example
INITPAD_ARTIFACT_S3_REGION=eu-central-1
INITPAD_ARTIFACT_S3_BUCKET=initpad-artifacts
INITPAD_ARTIFACT_S3_ACCESS_KEY_ID_FILE=/secure/runtime/secrets/s3_access_key_id
INITPAD_ARTIFACT_S3_SECRET_ACCESS_KEY_FILE=/secure/runtime/secrets/s3_secret_access_key
INITPAD_ARTIFACT_S3_FORCE_PATH_STYLE=false

# Platform secrets.
INITPAD_JWT_SECRET_FILE=/secure/runtime/secrets/jwt_secret
INITPAD_ENCRYPTION_KEY_FILE=/secure/runtime/secrets/encryption_key
INITPAD_SCM_WEBHOOK_TOKEN_FILE=/secure/runtime/secrets/scm_webhook_token
INITPAD_OIDC_CLIENT_SECRET_FILE=/secure/runtime/secrets/oidc_client_secret

# Transactional authentication e-mail. The password is projected by the
# deployment secret manager; STARTTLS is mandatory in the SaaS profile.
INITPAD_SMTP_HOST=smtp.example
INITPAD_SMTP_PORT=587
INITPAD_SMTP_SECURE=false
INITPAD_SMTP_USERNAME=initpad
INITPAD_SMTP_PASSWORD_FILE=/secure/runtime/secrets/smtp_password
INITPAD_SMTP_FROM=InitPad <no-reply@initpad.example>

# GitHub App and OAuth binding.
INITPAD_GITHUB_APP_ID=REPLACE
INITPAD_GITHUB_CLIENT_ID=REPLACE
INITPAD_GITHUB_CLIENT_SECRET_FILE=/secure/runtime/secrets/github_client_secret
INITPAD_GITHUB_PRIVATE_KEY_FILE=/secure/runtime/secrets/github_private_key
INITPAD_GITHUB_WEBHOOK_SECRET_FILE=/secure/runtime/secrets/github_webhook_secret
INITPAD_GITHUB_APP_SLUG=replace

# Bind only to the local edge proxy. Public exposure belongs at the WAF/edge.
INITPAD_WEB_BIND_ADDRESS=127.0.0.1
INITPAD_WEB_PORT=8080
INITPAD_TRUST_PROXY_HOPS=1
