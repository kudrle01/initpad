# InitPad public control-plane contract. Copy only for a staging deployment.
# Values marked EXTERNAL_SECRET must be injected by the deployment environment
# from its secret manager; never commit the populated file.

INITPAD_PUBLIC_URL=https://initpad.example
INITPAD_PLATFORM_VERSION=0.2.10
INITPAD_UPDATE_REPOSITORY=kudrle01/initpad

# Use immutable references from one verified InitPad platform release.
INITPAD_API_IMAGE=ghcr.io/kudrle01/initpad-api@sha256:REPLACE_WITH_64_HEX_DIGEST
INITPAD_WEB_IMAGE=ghcr.io/kudrle01/initpad-web@sha256:REPLACE_WITH_64_HEX_DIGEST
INITPAD_AGENT_IMAGE=ghcr.io/kudrle01/initpad-agent@sha256:REPLACE_WITH_64_HEX_DIGEST
INITPAD_AGENT_RELEASE_VERSION=0.14.3

# External PostgreSQL. TLS and certificate requirements belong in this URL.
INITPAD_DATABASE_URL=EXTERNAL_SECRET

# External private S3-compatible store. Leave endpoint empty only for AWS S3.
INITPAD_ARTIFACT_S3_ENDPOINT=https://s3.example
INITPAD_ARTIFACT_S3_REGION=eu-central-1
INITPAD_ARTIFACT_S3_BUCKET=initpad-artifacts
INITPAD_ARTIFACT_S3_ACCESS_KEY_ID=EXTERNAL_SECRET
INITPAD_ARTIFACT_S3_SECRET_ACCESS_KEY=EXTERNAL_SECRET
INITPAD_ARTIFACT_S3_FORCE_PATH_STYLE=false

# Platform secrets.
INITPAD_JWT_SECRET=EXTERNAL_SECRET
INITPAD_ENCRYPTION_KEY=EXTERNAL_SECRET
INITPAD_SCM_WEBHOOK_TOKEN=EXTERNAL_SECRET
INITPAD_OIDC_CLIENT_SECRET=EXTERNAL_SECRET

# GitHub App and OAuth binding.
INITPAD_GITHUB_APP_ID=REPLACE
INITPAD_GITHUB_CLIENT_ID=REPLACE
INITPAD_GITHUB_CLIENT_SECRET=EXTERNAL_SECRET
INITPAD_GITHUB_PRIVATE_KEY=EXTERNAL_SECRET
INITPAD_GITHUB_WEBHOOK_SECRET=EXTERNAL_SECRET
INITPAD_GITHUB_APP_SLUG=replace

# Bind only to the local edge proxy. Public exposure belongs at the WAF/edge.
INITPAD_WEB_BIND_ADDRESS=127.0.0.1
INITPAD_WEB_PORT=8080
INITPAD_TRUST_PROXY_HOPS=1
