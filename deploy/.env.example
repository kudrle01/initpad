# InitPad configuration. Copy to .env (install.sh does this for you) —
# values marked __GENERATE__ are filled with random secrets on first run.
COMPOSE_FILE=docker-compose.yml:.runtime/platform-update/platform-release.override.yml

# ---- addresses ------------------------------------------------------------
# Local install: leave the defaults.
# Server install: set the three domains/hosts below and the *_URL variables.

# Public URL of the platform web UI.
INITPAD_PUBLIC_URL=http://localhost:8080
# The same URL is written to GitHub Actions as its CI callback. In SaaS it must
# be a public HTTPS origin; localhost is valid only for self-hosted Gitea CI.
# Built-in deployment links use this URL's hostname too, so a LAN install has
# only one address to configure. Set the following optional override only when
# built-in apps intentionally use another browser-facing hostname:
INITPAD_DEPLOY_PUBLIC_HOST=

# Public URL of Gitea (must match INITPAD_GITEA_HTTP_PORT locally).
INITPAD_GITEA_PUBLIC_URL=http://gitea.localhost:3001

# Gitea address embedded into isolated CI checkout jobs. `*.localhost` is
# intentionally not used here: glibc resolves it to IPv6 loopback inside the
# runner image before Docker's IPv4 host mapping.
INITPAD_GITEA_RUNNER_URL=http://host.docker.internal:3001

# Registry as reachable from the HOST Docker daemon. Use the literal IPv4
# loopback locally: *.localhost may prefer ::1 on plain Linux while Gitea's
# published port is IPv4-only. On a server use the Gitea domain (HTTPS).
INITPAD_REGISTRY_HOST=127.0.0.1:3001

# Same registry as reachable from isolated CI jobs / their nested daemon.
INITPAD_CI_REGISTRY_HOST=host.docker.internal:3001

# install.sh fills both values from the reviewed, version-controlled
# agent-release.env when they are blank. Set a complete explicit pair only to
# pin another verified release; a partial pair is rejected.
INITPAD_AGENT_IMAGE=
INITPAD_AGENT_RELEASE_VERSION=

# Signed self-hosted platform releases. install.sh writes the absolute checkout
# root and current reviewed version; the shared secret authenticates only the
# private API-to-Supervisor channel.
INITPAD_INSTALL_ROOT=
INITPAD_PLATFORM_VERSION=0.2.16
INITPAD_UPDATE_REPOSITORY=kudrle01/initpad
# Keep customer installations on stable. Use candidate only on a disposable
# acceptance control plane while validating a GitHub prerelease.
INITPAD_AGENT_UPDATE_CHANNEL=stable
INITPAD_PLATFORM_UPDATE_CHANNEL=stable

# Optional OpenTelemetry OTLP/HTTP export. Leave disabled for a standalone
# installation. When enabled, point only at a trusted private collector.
INITPAD_OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=initpad-api
OTEL_METRIC_EXPORT_INTERVAL=60000
INITPAD_SUPERVISOR_SHARED_SECRET=__GENERATE__

# Published host ports (local installs).
INITPAD_WEB_PORT=8080
INITPAD_GITEA_HTTP_PORT=3001
# Number of trusted reverse-proxy hops in front of the API. The bundled web
# proxy is one hop. Set 0 only when clients reach the API directly; set a higher
# value only for a fixed, verified edge topology.
INITPAD_TRUST_PROXY_HOPS=1

# Public address ranges shared by many users, such as a school behind NAT
# (comma-separated CIDR, e.g. 198.51.100.0/24). Sign-in, registration and other
# per-IP limits are multiplied by the factor for them; limits per account stay.
INITPAD_RATE_LIMIT_SHARED_NETWORKS=
INITPAD_RATE_LIMIT_SHARED_NETWORK_FACTOR=20

# Audit events (workspace and platform) older than this many days are deleted.
# 0 keeps them; otherwise at least 30 (ADR-150).
INITPAD_AUDIT_RETENTION_DAYS=400

# Team workspaces one account may own (0 = unlimited). Platform administrators
# are exempt (ADR-154).
INITPAD_MAX_OWNED_TEAM_WORKSPACES=0

# Local Agent DinD acceptance lab only. The isolated nested Docker daemon uses
# this dedicated loopback range for browser-reachable test workloads. These
# values do not configure production Agent servers.
INITPAD_AGENT_LAB_BIND_ADDRESS=127.0.0.1
INITPAD_AGENT_LAB_GATEWAY_PORT=4180
INITPAD_AGENT_LAB_PORT_START=42000
INITPAD_AGENT_LAB_PORT_END=42031
# Managed-gateway acceptance edge. The reserved .test zone and TLS listener
# stay on this machine; they are not a production DNS or ingress setup.
INITPAD_AGENT_LAB_GATEWAY_DOMAIN=apps.initpad.test
INITPAD_AGENT_LAB_DNS_PORT=5533
INITPAD_AGENT_LAB_TLS_PORT=443
INITPAD_AGENT_LAB_EDGE_SUBNET=172.31.251.0/24
INITPAD_AGENT_LAB_EDGE_GATEWAY=172.31.251.1
INITPAD_AGENT_LAB_EDGE_IP=172.31.251.10
INITPAD_AGENT_LAB_DNS_IP=172.31.251.53

# Resource envelope for every app container created by the platform. The safe
# default keeps random direct-port deployments on this host. Set 0.0.0.0 only
# when trusted LAN clients must reach them directly, or use managed gateway.
INITPAD_DEPLOY_BIND_ADDRESS=127.0.0.1
INITPAD_DEPLOY_MEMORY_MB=512
INITPAD_DEPLOY_CPU=1
INITPAD_DEPLOY_PIDS_LIMIT=256

# The bundled runner executes one CI job at a time: every job runs on its own
# freshly erased Docker daemon (ADR-138). The installer accepts only 1.
INITPAD_RUNNER_CAPACITY=1

# Resource envelope of the CI Docker daemon and every container a job starts.
# A higher CPU limit also shortens loading the job image at each job start.
# The safe default preserves resources for the web/API on a small VM.
INITPAD_RUNNER_MEMORY_LIMIT=1536m
INITPAD_RUNNER_CPU_LIMIT=1.0
INITPAD_RUNNER_PIDS_LIMIT=512

# Server installs only (enables the "server" profile with Caddy + HTTPS):
#INITPAD_DOMAIN=platform.example.org
#INITPAD_GIT_DOMAIN=git.example.org
# HTTPS mode (ADR-062). Leave empty for public automatic Let's Encrypt. On a LAN
# / school network without public reachability, set to "tls internal" — Caddy
# issues certs from its own local CA (install that root on clients; see
# OPERATIONS.md).
#INITPAD_TLS_DIRECTIVE=tls internal

# ---- secrets (filled by install.sh) ----------------------------------------
INITPAD_JWT_SECRET=__GENERATE__
INITPAD_ENCRYPTION_KEY=__GENERATE__
# Only while rotating INITPAD_ENCRYPTION_KEY: the previous key, so the API can
# read and re-encrypt what it stored. Remove it once the API logs that every
# stored secret uses the current key (OPERATIONS.md).
#INITPAD_ENCRYPTION_KEY_PREVIOUS=
INITPAD_SCM_WEBHOOK_TOKEN=__GENERATE__
INITPAD_OIDC_CLIENT_SECRET=__GENERATE__
INITPAD_DB_PASSWORD=__GENERATE__
INITPAD_SFTP_PASSWORD=__GENERATE__
INITPAD_BOT_PASSWORD=__GENERATE__
# One-time proof for creating the first (administrator) account. install.sh
# prints it while the instance has no account yet (ADR-136).
INITPAD_BOOTSTRAP_TOKEN=__GENERATE__

# ---- transactional e-mail delivery (optional for self-hosted) -------------
# Leave INITPAD_SMTP_HOST and INITPAD_SMTP_FROM empty to keep the one-time
# manual activation/verification links in the administrator and account UI.
# Public installations should use an authenticated relay with STARTTLS.
INITPAD_SMTP_HOST=
INITPAD_SMTP_PORT=587
INITPAD_SMTP_SECURE=false
INITPAD_SMTP_REQUIRE_TLS=true
INITPAD_SMTP_USERNAME=
INITPAD_SMTP_PASSWORD=
INITPAD_SMTP_FROM=

# Self-hosted registration policy (ADR-040, ADR-136). The first account always
# bootstraps the instance administrator regardless of the value, using the
# INITPAD_BOOTSTRAP_TOKEN printed by install.sh.
#   admin-provisioned = accounts created by the instance administrator (default)
#   open              = anyone who reaches the instance can sign up and deploy
#                       to the built-in Docker host; use only on a trusted network
# Legacy invite-only/first-user/closed still work as admin-provisioned aliases.
INITPAD_REGISTRATION_MODE=admin-provisioned

# Product edition: self-hosted (embedded Gitea) or saas (GitHub control plane).
INITPAD_EDITION=self-hosted

# ---- durable artifact object storage (ADR-059) -----------------------------
# Verified build images are stored in a private S3-compatible bucket (source of
# truth) and cached in the local Docker daemon. Local install: leave the
# defaults — the bundled MinIO is used for local evaluation and trusted
# single-node installations only. Production/SaaS must point these at a
# separately maintained S3-compatible service; see deploy/OPERATIONS.md.
# The SaaS edition refuses to start when the bucket/credentials are unset.
INITPAD_ARTIFACT_S3_ENDPOINT=http://minio:9000
INITPAD_ARTIFACT_S3_REGION=us-east-1
INITPAD_ARTIFACT_S3_BUCKET=initpad-artifacts
INITPAD_ARTIFACT_S3_ACCESS_KEY_ID=initpad
INITPAD_ARTIFACT_S3_SECRET_ACCESS_KEY=__GENERATE__
# MinIO and most non-AWS S3 servers require path-style addressing.
INITPAD_ARTIFACT_S3_FORCE_PATH_STYLE=true
# Presigned download link lifetime (seconds, 30–3600) and artifact retention.
INITPAD_ARTIFACT_PRESIGN_TTL_SECONDS=300
INITPAD_ARTIFACT_RETENTION_DAYS=30

# GitHub App (hosted edition, ADR-030). Optional: when unset the GitHub adapter
# stays inert and only the embedded Gitea path is used. INITPAD_GITHUB_PRIVATE_KEY
# accepts a PEM with literal \n escapes.
INITPAD_GITHUB_APP_ID=
INITPAD_GITHUB_CLIENT_ID=
INITPAD_GITHUB_CLIENT_SECRET=
INITPAD_GITHUB_PRIVATE_KEY=
INITPAD_GITHUB_WEBHOOK_SECRET=
# Public App slug (from the App's URL github.com/apps/<slug>), for the install link.
INITPAD_GITHUB_APP_SLUG=
# OAuth callback; must match the App's configured callback URL, for example:
# https://initpad.example/api/auth/github/callback
INITPAD_GITHUB_CALLBACK_URL=
# Configure the GitHub App's Setup URL separately (it is a route, not a secret):
# https://initpad.example/api/scm/github/setup/callback
# Configure its Webhook URL as:
# https://initpad.example/api/scm/github/webhook
# Minimum Repository permissions for create/import/deploy: Administration write,
# Contents write, Workflows write, Secrets write, Packages write and Actions
# read/write (Metadata read is implicit). Actions write is used only for an
# explicit failed-job retry; Checks read is an optional legacy fallback.
# No Organization or Account permission is needed.

# ---- filled during bootstrap (install.sh) ----------------------------------
# Service account the platform uses for Gitea administration.
INITPAD_BOT_USER=initpad-bot
INITPAD_GITEA_TOKEN=
INITPAD_RUNNER_TOKEN=
