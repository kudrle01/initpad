{
  "name": "initpad/generated-symfony-app",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "symfony/dotenv": "^7.3",
    "symfony/framework-bundle": "^7.3",
    "symfony/runtime": "^7.3",
    "symfony/string": "^7.3",
    "symfony/yaml": "^7.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "symfony/browser-kit": "^7.3",
    "symfony/css-selector": "^7.3"
  },
  "autoload": { "psr-4": { "App\\": "src/" } },
  "autoload-dev": { "psr-4": { "App\\Tests\\": "tests/" } },
  "config": {
    "sort-packages": true,
    "platform": { "php": "8.3.0" },
    "allow-plugins": { "symfony/runtime": true }
  },
  "extra": { "runtime": { "class": "Symfony\\Component\\Runtime\\SymfonyRuntime" } }
}
