<?php
// Front controller: FrankenPHP serves files from public/ and sends every other
// request here.
$path = parse_url($_SERVER['REQUEST_URI'], PHP_URL_PATH);
header('Content-Type: application/json');

if ($path === '/health') {
    echo json_encode(['status' => 'ok']);
    return;
}

echo json_encode([
    'service' => '{{projectName}}',
    'status' => 'ok',
    'php' => PHP_VERSION,
]);
