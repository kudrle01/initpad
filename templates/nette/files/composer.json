{
  "name": "initpad/generated-nette-app",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "nette/application": "^3.2",
    "nette/bootstrap": "^3.2",
    "nette/di": "^3.2",
    "nette/http": "^3.3",
    "nette/routing": "^3.1",
    "tracy/tracy": "^2.10"
  },
  "require-dev": { "phpunit/phpunit": "^11.5" },
  "autoload": { "psr-4": { "App\\": "app/" } },
  "autoload-dev": { "psr-4": { "App\\Tests\\": "tests/" } },
  "config": { "sort-packages": true, "platform": { "php": "8.3.0" } }
}
